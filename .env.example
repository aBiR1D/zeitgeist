# Zeitgeist Configuration
# Copy to .env and fill in your API keys

# LLM Provider (at least one required for AI-powered predictions)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Database (defaults to ~/.zeitgeist/zeitgeist.db)
# ZEITGEIST_DB=/path/to/zeitgeist.db

# API Server
ZEITGEIST_HOST=0.0.0.0
ZEITGEIST_PORT=8000
